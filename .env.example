# Restored Monday local configuration. Copy to .env.local; never commit credentials.
CVENT_ENV=development
CVENT_EXECUTION_MODE=simple
CVENT_LOCAL_CODEX=1
CVENT_PI_PROVIDER=openai-codex
CVENT_PI_MODEL=gpt-6-astra
CVENT_PI_THINKING=high
# Uses the current user's private ~/.pi/agent/auth.json OAuth login by default.
# No Anthropic or OpenAI API key is required for this mode.
CVENT_DEV_AUTH_SUBJECT=local-operator
CVENT_DEV_AUTH_NAME="Local operator"
CVENT_DEV_AUTH_ADMIN=1
CVENT_SESSION_COOKIE=ai_agent_that_works_monday_session
CVENT_DATA_ROOT=./data/monday-restored
CVENT_CONTAINER_PREFIX=ai-agent-that-works-steel
CVENT_WORKER_PORT_OFFSET=100
CVENT_LEASE_VALIDATE_URL=http://127.0.0.1:8880/internal/leases/validate

# REQUIRED: replace both UUID placeholders and the name/code with the exact
# existing Cvent event you authorize. Invalid placeholders fail closed.
# This enables intake before login; live event/auth/lease proof still gates writes.
CVENT_AUTHORIZED_EVENTS_JSON='[{"event_id":"<canonical-event-uuid>","event_key":"<canonical-event-uuid>","name":"<exact-event-name>","event_code":"<event-code>"}]'
